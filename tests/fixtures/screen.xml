  </node>
  <node text="Page 1 of 3." content-desc="" clickable="true" bounds="[500,1860][530,1900]"/>
  <node text="Page 2 of 3." content-desc="" clickable="true" bounds="[550,1860][580,1900]"/>
  <node text="Use PIN" content-desc="" clickable="true" bounds="[395,1452][686,1530]"/>
  <node text="PhonePe is locked" content-desc="" clickable="false" bounds="[30,920][1050,1064]"/>
  <node text="" content-desc="" clickable="true" bounds="[0,0][1080,100]"/>
  <node text="Broken bounds" content-desc="" clickable="true" bounds="not-a-rect"/>
</hierarchy>
